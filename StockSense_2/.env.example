# ==================================-
# App Configuration
# ==================================-
NODE_ENV=development
PORT=3000

# ==================================-
# Supabase Configuration
# ==================================-
# Project URL (Supabase Dashboard > Settings > API se milega)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public/Anon Key (Frontend ke liye)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (Backend/Worker ke liye - confidential)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==================================-
# Database Connection (PostgreSQL / Supabase)
# ==================================-
# Direct Database URL
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Direct Connection String (Prisma / Migrations ke liye agar required ho)
DIRECT_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ==================================-
# Backend API Service (FastAPI)
# ==================================-
BACKEND_API_URL=http://localhost:8000
SECRET_KEY=your-super-secret-jwt-key

# ==================================-
# Financial / Stock Data APIs (Optional)
# ==================================-
STOCK_DATA_API_KEY=your-stock-api-key